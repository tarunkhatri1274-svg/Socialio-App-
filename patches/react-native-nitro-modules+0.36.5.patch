+    } else {
+      // it is a custom type, parse it to a JS value
+      R result = function(JSIConverter<std::decay_t<Args>>::fromJSI(runtime, args[Is])...);
+      return JSIConverter<R>::toJSI(runtime, std::forward<R>(result));
+    }
+  }
+};
+
+} // namespace margelo::nitro
