+class JAnyValue final : public jni::HybridClass<JAnyValue> {
+public:
+  static constexpr auto kJavaDescriptor = "Lcom/margelo/nitro/core/AnyValue;";
+
+  /**
+   * Represents an `Array<AnyValue>`
+   */
