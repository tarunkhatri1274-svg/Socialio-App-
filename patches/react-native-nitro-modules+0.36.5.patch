+struct MutableBufferNativeState final : public jsi::NativeState {
+public:
+  explicit MutableBufferNativeState(const std::shared_ptr<jsi::MutableBuffer>& buffer) : buffer(buffer) {}
+  std::shared_ptr<jsi::MutableBuffer> buffer;
+};
