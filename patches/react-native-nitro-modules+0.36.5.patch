+private:
+  friend HybridBase;
+  using HybridBase::HybridBase;
+  std::shared_ptr<ArrayBuffer> _arrayBuffer;
+
+public:
+  static void registerNatives() {
+    registerHybrid(
+        {makeNativeMethod("initHybrid", JArrayBuffer::initHybridByteBuffer),
