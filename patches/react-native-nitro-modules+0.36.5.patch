+public:
+  inline R operator()(Args... args) const {
+    if constexpr (std::is_void_v<R>) {
+      _func->invoke(std::forward<Args>(args)...);
+    } else {
+      return _func->invoke(std::forward<Args>(args)...);
+    }
+  }
+
+private:
+  jni::global_ref<JFunc> _func;
+};
