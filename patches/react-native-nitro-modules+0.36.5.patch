+  bool enumerable;
+  jsi::Value value;
+  bool writable;
+};
+struct ComputedReadonlyPropertyDescriptor {
+  bool configurable;
+  bool enumerable;
+  jsi::Function get;
+};
+struct ComputedPropertyDescriptor {
+  bool configurable;
+  bool enumerable;
+  jsi::Function get;
+  jsi::Function set;
+};
+
+enum class KnownGlobalPropertyName { DISPATCHER, JSI_CACHE, NITRO_MODULES_PROXY };
