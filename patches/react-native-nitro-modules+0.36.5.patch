+
+  /**
+   * https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Object
+   */
+  class Object final {
+  public:
+    Object() = delete;
+    ~Object() = delete;
+
+    /**
+     * Create a new `jsi::Object` with the given `prototype`.
+     * Uses a native implementation if possible.
