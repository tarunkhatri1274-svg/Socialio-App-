+  int getBufferSize() {
+    return static_cast<int>(_arrayBuffer->size());
+  }
+
+public:
+  /**
+   * Get the underlying `ArrayBuffer`.
+   */
+  [[nodiscard]] std::shared_ptr<ArrayBuffer> getArrayBuffer() const {
+    return _arrayBuffer;
+  }
+  /**
+   * Get the underlying `HardwareBuffer` if it has one.
