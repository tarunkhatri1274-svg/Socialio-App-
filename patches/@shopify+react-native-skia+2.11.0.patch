+    auto result =
+        getObject()->getRectsForRange(start, end, para::RectHeightStyle::kTight,
+                                      para::RectWidthStyle::kTight);
+    std::vector<std::shared_ptr<JsiSkRect>> rects;
+    rects.reserve(result.size());
