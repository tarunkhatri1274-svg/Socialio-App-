+
+  explicit JsiSkParagraph(std::shared_ptr<RNSkPlatformContext> context,
+                          para::ParagraphBuilder *paragraphBuilder)
+      : JsiSkWrappingSharedPtrNativeObject<JsiSkParagraph, para::Paragraph>(
