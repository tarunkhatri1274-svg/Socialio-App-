+                                           value_max, bucket_count)
+#endif
+
+#ifndef SK_HISTOGRAM_MEMORY_KB
+#  define SK_HISTOGRAM_MEMORY_KB(name, sample)
+#endif
+
+#ifndef SK_HISTOGRAM_CUSTOM_COUNTS
