+
+  JsiSkFontStyle(std::shared_ptr<RNSkPlatformContext> context,
+                 const SkFontStyle &fontStyle)
+      : JsiSkWrappingSharedPtrNativeObject<JsiSkFontStyle, SkFontStyle>(
