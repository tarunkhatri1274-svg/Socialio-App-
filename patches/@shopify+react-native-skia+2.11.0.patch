+    if (isGpuBacked) {
+      // Account for a resolved texture and depth/stencil attachments.
+      estimated = safeAdd(estimated, pixelBytes);     // resolve/texture copy
+      estimated = safeAdd(estimated, pixelBytes / 2); // depth-stencil buffers
+    }
