+            std::optional<std::chrono::microseconds> microsMaxPurgingDur = std::nullopt);
+
+    /**
+     * Returns the number of bytes of the Recorder's gpu memory cache budget that are currently in
+     * use.
+     */
+    size_t currentBudgetedBytes() const;
