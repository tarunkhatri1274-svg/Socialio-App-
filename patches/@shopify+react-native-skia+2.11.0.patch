+        #else
+            #define SKCMS_HAS_MUSTTAIL 0
+        #endif
+    #endif
+#endif
+
+#ifndef SKCMS_FALLTHROUGH
+    #define SKCMS_FALLTHROUGH
+#endif
+#ifndef SKCMS_HAS_MUSTTAIL
+    #define SKCMS_HAS_MUSTTAIL 0
+#endif
+
+#if defined(__clang__)
