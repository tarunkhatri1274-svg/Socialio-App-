+class ViewProperty {
+public:
+  ViewProperty(jsi::Runtime &runtime, const jsi::Value &value) {
+    auto jsiPicture =
+        RNSkia::tryGetJsiObject<RNSkia::JsiSkPicture>(runtime, value);
+    if (jsiPicture) {
+      _value = jsiPicture->getObject();
+    }
