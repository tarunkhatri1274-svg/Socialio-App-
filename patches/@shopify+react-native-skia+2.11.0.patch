+  std::shared_ptr<JsiSkShader> MakeTurbulence(double baseFreqX,
+                                              double baseFreqY, double octaves,
+                                              double seed, double tileW,
+                                              double tileH) {
+    SkISize size = SkISize::Make(tileW, tileH);
+    sk_sp<SkShader> gradient =
