+            position.setProperty(runtime, "x",
+                                 static_cast<double>(info->positions[i].x()));
+            position.setProperty(runtime, "y",
+                                 static_cast<double>(info->positions[i].y()));
+            positions.setValueAtIndex(runtime, i, position);
