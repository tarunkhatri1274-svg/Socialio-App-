+    convertProperty(runtime, object, "mode", props.mode, variables);
+  }
+
+  void pushImageFilter(DrawingCtx *ctx) {
+    auto imgf =
+        SkImageFilters::Blur(props.blur.rX, props.blur.rY, props.mode, nullptr);
+    ctx->imageFilters.push_back(imgf);
