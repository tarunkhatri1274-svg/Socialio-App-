+    names.push_back(jsi::PropNameID::forUtf8(rt, "unbox"));
+    names.push_back(jsi::PropNameID::forUtf8(rt, "__boxedNativeObject"));
+    names.push_back(jsi::PropNameID::forUtf8(rt, "__brand"));
+    return names;
+  }
