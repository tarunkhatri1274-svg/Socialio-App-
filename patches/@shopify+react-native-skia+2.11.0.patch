+template <typename T, typename P>
+SI T load(const P* ptr) {
+    T val;
+    memcpy(&val, ptr, sizeof(val));
+    return val;
+}
+template <typename T, typename P>
+SI void store(P* ptr, const T& val) {
+    memcpy(ptr, &val, sizeof(val));
