+SK_API sk_sp<SkImage> TextureFromYUVAPixmaps(GrRecordingContext* context,
+                                             const SkYUVAPixmaps& pixmaps,
+                                             skgpu::Mipmapped buildMips,
+                                             bool limitToMaxTextureSize,
+                                             sk_sp<SkColorSpace> imageColorSpace);
+SK_API sk_sp<SkImage> TextureFromYUVAPixmaps(GrRecordingContext* context,
+                                             const SkYUVAPixmaps& pixmaps,
