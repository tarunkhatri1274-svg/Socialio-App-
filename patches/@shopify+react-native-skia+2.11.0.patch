diff --git a/node_modules/@shopify/react-native-skia/android/build/headers/rnskia/react-native-skia/include/utils/SkCanvasStateUtils.h b/node_modules/@shopify/react-native-skia/android/build/headers/rnskia/react-native-skia/include/utils/SkCanvasStateUtils.h
