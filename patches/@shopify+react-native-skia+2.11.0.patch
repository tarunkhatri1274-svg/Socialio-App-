diff --git a/node_modules/@shopify/react-native-skia/android/build/headers/rnskia/react-native-skia/include/core/SkSamplingOptions.h b/node_modules/@shopify/react-native-skia/android/build/headers/rnskia/react-native-skia/include/core/SkSamplingOptions.h
