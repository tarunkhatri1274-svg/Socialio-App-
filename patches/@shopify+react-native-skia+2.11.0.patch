+    T& operator[] (int i) {
+        return fData[sk_collection_check_bounds(i, this->size())];
+    }
+
+    const T& operator[] (int i) const {
+        return fData[sk_collection_check_bounds(i, this->size())];
+    }
+
+    T& at(int i) { return (*this)[i]; }
+    const T& at(int i) const { return (*this)[i]; }
+
+    /**
