+  }
+
+  JSI_HOST_FUNCTION(getRectsForPlaceholders) {
+    std::vector<para::TextBox> placeholderInfos =
+        getObject()->getRectsForPlaceholders();
+    auto returnValue = jsi::Array(runtime, placeholderInfos.size());
